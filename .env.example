# Copy to .env.local (or .env) and fill in real values. See README.md.

# --- This repo's OWN database (agent_runs, agent_permissions, and later
# sales_goals/manager_decisions/etc.) — separate from hartwich-os's
# database. Any Postgres works; a free Supabase project is the path of
# least resistance since hartwich-os already uses one. ---
AGENT_DATABASE_URL=

# --- Read (and, in later phases, narrowly-scoped write) access to
# hartwich-os's OWN database — its `DATABASE_URL` (Supabase transaction-
# pooler URI). Required for any tool that touches real CRM data
# (src/tools/get-company.ts and later tools); not required for tests or
# the zero-config demo (npm run demo:company-lookup), which use a fixture
# instead. ---
HARTWICH_DATABASE_URL=

# --- Google Places API (New) — Prospect Discovery (Phase 2). Same key
# shape as hartwich-os's own GOOGLE_PLACES_API_KEY; this repo calls the
# Places API directly (it's a separate service — see README.md
# "Architecture"), not through hartwich-os's code. Not required for tests
# or `npm run demo:discover`, which use a fixture instead. ---
GOOGLE_PLACES_API_KEY=

# --- Groq — the "fast" model lane (classification/extraction/routing).
# Free tier, no billing required — console.groq.com/keys. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic — the "strong" model lane (research, strategic reasoning,
# complex conversations, Sales Manager decisions). Unblocked by Gavin
# 2026-09-09 for this project specifically — see GAP_ANALYSIS.md §8 and
# SPEC.md's header note. Real spend; used deliberately by agents whose
# modelLane is "strong", not by default. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Gmail (Phase 5 — Outreach Execution). Same 3-rotating-account shape
# as hartwich-os's own env vars — this repo sends from the SAME physical
# Gmail accounts (a shared warm-up state table, see src/db/hartwich-os/
# email-accounts-store.ts), so these should be the identical values
# already in hartwich-os's environment, not a second set of accounts.
# Not required for tests or the zero-config demos, which fake the send.
# See hartwich-os/.env.example for the full OAuth setup walkthrough
# (Google Cloud Console -> enable Gmail API -> OAuth 2.0 client -> OAuth
# Playground per account for a refresh token). ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCESS_TOKEN_1=
GMAIL_REFRESH_TOKEN_1=
GMAIL_FROM_ADDRESS_1=
GMAIL_ACCESS_TOKEN_2=
GMAIL_REFRESH_TOKEN_2=
GMAIL_FROM_ADDRESS_2=
GMAIL_ACCESS_TOKEN_3=
GMAIL_REFRESH_TOKEN_3=
GMAIL_FROM_ADDRESS_3=
